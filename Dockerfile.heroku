FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BACKEND_URL=http://127.0.0.1:8000

WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt
COPY frontend/requirements.txt ./frontend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt -r frontend/requirements.txt

COPY backend/app ./backend/app
COPY frontend/streamlit_app_v0.4.py ./frontend/streamlit_app.py

EXPOSE 8501

CMD bash -c "cd /app/backend && uvicorn app.main:app --host 127.0.0.1 --port 8000 & cd /app/frontend && streamlit run streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true & wait -n; exit \$?"